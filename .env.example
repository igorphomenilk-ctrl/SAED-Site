# Ambiente local — copie para .env.local e preencha os valores.
# NUNCA versionar chaves reais.

# Obrigatória para envio de e-mails (server-side only)
RESEND_API_KEY=

# Destinatário administrativo das notificações
SAED_ADMIN_EMAIL=saed.gerenciador@gmail.com

# Remetente das notificações internas / visitas
SAED_FROM_EMAIL=noreply@saed.app.br

# Remetente da confirmação ao interessado
SAED_CONTACT_EMAIL=contato@saed.app.br

# URL canônica do site (validação de origem + links nos e-mails)
SAED_SITE_URL=https://saed.app.br

# Cooldown de notificação de visita por sessão/IP (minutos). Padrão: 1440 (24h)
SAED_VISIT_NOTIFICATION_COOLDOWN_MINUTES=1440
